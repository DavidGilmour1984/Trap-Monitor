<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>UART Monitor (Robust Debug)</title>

<style>
body {
  font-family: Helvetica;
  background:#f5f7fb;
  padding:20px;
}

.card {
  background:white;
  padding:20px;
  border-radius:16px;
  max-width:900px;
  margin:auto;
}

button {
  font-size:26px;
  padding:12px;
  margin:6px 0;
  border:none;
  border-radius:12px;
  width:100%;
}

.connect { background:#2563eb; color:white; }
.disconnect { background:#dc2626; color:white; }
.clear { background:#6b7280; color:white; }

.box {
  font-family:monospace;
  border-radius:10px;
  padding:10px;
  height:200px;
  overflow-y:auto;
  margin-top:10px;
}

.raw { background:#111827; color:#22c55e; }
.hex { background:#1f2937; color:#e5e7eb; }
.text { background:#eef2ff; color:#111; }

.status {
  font-size:22px;
  margin-top:10px;
}
</style>
</head>

<body>
<div class="card">

<h2>UART Debug Monitor</h2>

<button class="connect" onclick="connect()">Connect</button>
<button class="disconnect" onclick="disconnect()">Disconnect</button>
<button class="clear" onclick="clearAll()">Clear</button>

<div class="status" id="status">Status: Disconnected</div>

<h3>ASCII (decoded)</h3>
<div class="box text" id="textBox"></div>

<h3>RAW HEX (actual bytes)</h3>
<div class="box hex" id="hexBox"></div>

<h3>RAW STREAM</h3>
<div class="box raw" id="rawBox"></div>

</div>

<script>
let port;
let reader;
let running = false;

// buffer for text decoding
let textBuffer = "";

// connect
async function connect() {
  try {
    port = await navigator.serial.requestPort();

    await port.open({
      baudRate: 9600,
      dataBits: 8,
      stopBits: 1,
      parity: "none"
    });

    document.getElementById("status").textContent = "Status: Connected";

    running = true;
    readLoop();

  } catch (e) {
    document.getElementById("status").textContent = "ERROR: " + e;
  }
}

// main read loop
async function readLoop() {
  reader = port.readable.getReader();

  while (running) {
    const { value, done } = await reader.read();
    if (done) break;

    if (value) {
      processBytes(value);
    }
  }
}

// process incoming bytes
function processBytes(bytes) {

  const rawBox = document.getElementById("rawBox");
  const hexBox = document.getElementById("hexBox");
  const textBox = document.getElementById("textBox");

  // ===== RAW STREAM =====
  let rawText = "";
  for (let b of bytes) {
    rawText += String.fromCharCode(b);
  }
  rawBox.textContent += rawText;

  // ===== HEX VIEW =====
  let hexLine = "";
  for (let b of bytes) {
    hexLine += b.toString(16).padStart(2, "0") + " ";
  }
  hexBox.textContent += hexLine + "\n";

  // ===== ASCII BUFFER =====
  for (let b of bytes) {
    if (b >= 32 && b <= 126) {
      textBuffer += String.fromCharCode(b);
    } else if (b === 10 || b === 13) {
      // newline
      if (textBuffer.length > 0) {
        textBox.textContent += textBuffer + "\n";
        textBuffer = "";
      }
    }
  }

  // auto scroll
  rawBox.scrollTop = rawBox.scrollHeight;
  hexBox.scrollTop = hexBox.scrollHeight;
  textBox.scrollTop = textBox.scrollHeight;
}

// disconnect
async function disconnect() {
  running = false;

  if (reader) {
    await reader.cancel();
    reader.releaseLock();
  }

  if (port) {
    await port.close();
  }

  document.getElementById("status").textContent = "Status: Disconnected";
}

// clear
function clearAll() {
  document.getElementById("rawBox").textContent = "";
  document.getElementById("hexBox").textContent = "";
  document.getElementById("textBox").textContent = "";
}
</script>

</body>
</html>
